<Window x:Class="m3u_editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:m3u_editor"
        mc:Ignorable="d"
        Title="M3U Viewer &amp; Editor" Height="600" Width="900" WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="10,10,10,5">
            <Button Content="Colar / Carregar M3U" Click="BtnLoad_Click" Padding="15,5" Margin="0,0,10,0"/>
            <Button Content="Exportar M3U Editado" Click="BtnExport_Click" Padding="15,5" Background="#E1F5FE"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="10,5,10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Categorias" Grid.Column="0" Margin="0,0,5,0">
                <ListBox x:Name="ListCategories" SelectionChanged="ListCategories_SelectionChanged" DisplayMemberPath="GroupTitle">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Excluir Categoria Inteira" Click="MenuDeleteCategory_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </GroupBox>

            <GroupBox Header="Conteúdo da Categoria Selecionada" Grid.Column="1" Margin="5,0,0,0">
                <DataGrid x:Name="GridItems" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          SelectionMode="Extended" 
                          AlternatingRowBackground="#F9F9F9"
                          PreviewKeyDown="GridItems_PreviewKeyDown"
                          MouseDoubleClick="GridItems_MouseDoubleClick">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Excluir Item(ns) Selecionado(s)" Click="MenuDelete_Click" InputGestureText="Delete"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nome" Binding="{Binding DisplayName}" Width="2*"/>
                        <DataGridTextColumn Header="Grupo/Categoria" Binding="{Binding GroupTitle}" Width="1.5*"/>
                        <DataGridTextColumn Header="Logo URL" Binding="{Binding TvgLogo}" Width="1.5*"/>
                        <DataGridTextColumn Header="Stream URL" Binding="{Binding Url}" Width="3*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <StatusBar Grid.Row="2" Background="#F0F0F0" BorderBrush="#D3D3D3" BorderThickness="0,1,0,0" Padding="5,3">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Total de Itens: " FontWeight="Bold" Foreground="#555"/>
                    <TextBlock x:Name="TxtTotalItems" Text="0" Margin="0,0,15,0"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Itens na Categoria: " FontWeight="Bold" Foreground="#555"/>
                    <TextBlock x:Name="TxtCategoryItems" Text="0" Margin="0,0,15,0"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Tamanho Estimado: " FontWeight="Bold" Foreground="#555"/>
                    <TextBlock x:Name="TxtFileSize" Text="0 bytes"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
